# ─────────────────────────────────────────────────────────────────────
# ChatHermes — environment configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in only what you need.
# At minimum: PUBLIC_BASE_URL, SESSION_SECRET, and ONE LLM provider key.
# Everything else is optional — features degrade gracefully when keys
# are absent (e.g. emails print to console if Resend isn't configured).
#
# Need help? https://github.com/chathermes/chathermes
# Or use the hosted version: https://chathermes.com (config-free)
# ─────────────────────────────────────────────────────────────────────

PORT=7000
WORKSPACE_UI_URL=http://127.0.0.1:7001
DATA_ROOT=./data
TENANT_PORT_START=7100
TENANT_PORT_END=7999
ENGINE_IMAGE=chathermes/engine:latest
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
DEFAULT_MODEL=kimi-k2-0711-preview
PUBLIC_BASE_URL=http://localhost:7000


# ============================================================
# Pricing — per-model credit rate (optional)
# ============================================================
# JSON: { "model_id": credits_per_1k_tokens, ... }
# Models not listed use CHATHERMES_DEFAULT_RATE.
# Vibe-coding generations get an automatic 3× multiplier.
# Example:
#   CHATHERMES_MODEL_RATES={"moonshotai/kimi-k2-thinking":1,"openai/gpt-5":6}
CHATHERMES_MODEL_RATES=
CHATHERMES_DEFAULT_RATE=1


# ============================================================
# PRIVATE AGENT auto-provisioning (Hetzner-backed Pro feature)
# ============================================================
# When a user upgrades to a paid plan, ChatHermes can auto-spawn a
# dedicated Hetzner Cloud server running an isolated Hermes Agent
# proxy on :19002 for that user. By default, this is GATED — the
# Stripe webhook marks the user as "pending" and an admin clicks
# Provision in /admin/private-agents to actually spawn the server.
# To enable full automation:
AUTO_PROVISION_PRIVATE_AGENT=false

# Hetzner Cloud API token (alternative to setting via /admin/hetzner UI)
# HETZNER_API_TOKEN=hcloud_...

# Where the SHARED Hermes Agent proxy listens on this server
# (free-tier users hit this; paid users with provisioned private
# agents bypass to their own endpoint).
HERMES_PROXY_PORT=19002
HERMES_UPSTREAM_MODEL=Hermes-4-405B
HERMES_RATE_LIMIT=60


# ============================================================
# Optional tool keys (graceful degradation if absent)
# ============================================================
# Image generation (generate_image tool) — Replicate Flux Schnell
# REPLICATE_API_TOKEN=

# Vision analysis (analyze_image tool) — Gemini 2.0 Flash or GPT-4o
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Web search (web_search tool, tier 1+2) — graceful fallback to DDG/Wikipedia
# TAVILY_API_KEY=
# BRAVE_API_KEY=
