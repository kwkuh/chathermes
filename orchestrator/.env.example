# -----------------------------------------------------------------------
# ChatHermes - environment configuration
# -----------------------------------------------------------------------
# Copy this file to .env and fill in only what you need.
# At minimum: PUBLIC_BASE_URL, SESSION_SECRET, and ONE LLM provider key.
# Everything else is optional - features degrade gracefully when keys
# are absent (e.g. emails print to console if Resend isn't configured).
#
# Need help? https://github.com/chathermes/chathermes
# Or use the hosted version: https://chathermes.com (config-free)
# -----------------------------------------------------------------------

# ============================================================
# CORE - required
# ============================================================
PUBLIC_BASE_URL=http://localhost:7000
NODE_ENV=development

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Comma-separated emails granted admin role on signup. Leave empty to
# require manual promotion via CLI: chathermes user grant-admin <email>
ADMIN_EMAILS=

# Where the SQLite DB + tenant volumes live. Relative to orchestrator/.
DATA_ROOT=./data

# ============================================================
# LLM provider keys - configure at least one
# ============================================================
NOUS_API_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
STEPFUN_API_KEY=

DEFAULT_MODEL=nousresearch/hermes-4-405b

# ============================================================
# Pricing - per-model credit rate (optional, default empty)
# ============================================================
# JSON: { "model_id": credits_per_1k_tokens, ... }
# Models not listed use CHATHERMES_DEFAULT_RATE.
# Vibe-coding generations get an automatic 3x multiplier.
# Example:
#   CHATHERMES_MODEL_RATES={"moonshotai/kimi-k2-thinking":1,"openai/gpt-5":6}
CHATHERMES_MODEL_RATES=
CHATHERMES_DEFAULT_RATE=1

# ============================================================
# EMAIL - Resend (optional, magic links print to log if absent)
# ============================================================
RESEND_API_KEY=
RESEND_FROM=ChatHermes <hello@example.com>
RESEND_REPLY_TO=hello@example.com
RESEND_WEBHOOK_SECRET=

# ============================================================
# BILLING - Stripe (optional, demo mode if absent)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Recurring subscription price IDs (create at dashboard.stripe.com/products)
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# One-time credit packs (optional)
STRIPE_PRICE_PACK_STARTER=
STRIPE_PRICE_PACK_BUILDER=
STRIPE_PRICE_PACK_POWER=
STRIPE_PRICE_PACK_MAX=

# ============================================================
# PRIVATE AGENT auto-provisioning (Pro feature, gated by default)
# ============================================================
# When a user upgrades to a paid plan, ChatHermes can auto-spawn a
# dedicated Hetzner Cloud server running an isolated Hermes Agent
# proxy on :19002 for that user. Default GATED - the Stripe webhook
# only marks the user as "pending" and an admin clicks Provision in
# /admin/private-agents to actually spawn the server.
# To enable full automation:
AUTO_PROVISION_PRIVATE_AGENT=false

# Hetzner Cloud API token (alternative to setting via /admin/hetzner UI)
# Create at: https://console.hetzner.cloud -> Security -> API tokens
HETZNER_API_TOKEN=

# Where the SHARED Hermes Agent proxy listens
HERMES_PROXY_PORT=19002
HERMES_UPSTREAM_MODEL=Hermes-4-405B
HERMES_RATE_LIMIT=60

# ============================================================
# Optional tool keys (graceful degradation if absent)
# ============================================================
# Image generation (generate_image tool) - Replicate Flux Schnell
REPLICATE_API_TOKEN=

# Vision analysis (analyze_image tool) - uses GEMINI_API_KEY or OPENAI_API_KEY above
# (no separate key needed)

# Web search (web_search tool) - tier 1+2 (Tavily/Brave). Falls back to DDG/Wikipedia.
TAVILY_API_KEY=
BRAVE_API_KEY=
